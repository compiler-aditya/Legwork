# Copy to .env and fill in. Never commit .env. Sandbox credentials only.

# PayPal (developer.paypal.com > Apps & Credentials > Sandbox).
# Turn on for the sandbox app: Save payment methods, Payouts. On the sandbox
# business account: partial capture. See docs/day-one-checks.md.
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# The id PayPal shows after you add the webhook URL to the sandbox app.
PAYPAL_WEBHOOK_ID=

# Day-one checks only. A sandbox personal (buyer) account email to receive a test payout.
PAYPAL_TEST_PAYOUT_EMAIL=
# Optional: a US mobile number and a Venmo handle for the Venmo payout checks.
PAYPAL_TEST_PAYOUT_PHONE=
PAYPAL_TEST_VENMO_HANDLE=

# Claude (agents). Model: claude-opus-5-5.
ANTHROPIC_API_KEY=

# ElevenLabs Agents (voice calls) with an imported Twilio number.
# `npm run voice:setup` creates the agent and its tools and prints ELEVENLABS_AGENT_ID.
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
ELEVENLABS_PHONE_NUMBER_ID=
# The post-call webhook's secret (Agents > Settings > Post-call webhook).
ELEVENLABS_WEBHOOK_SECRET=
# Optional: a voice from your ElevenLabs library, and the agent's model (default claude-sonnet-5-5).
ELEVENLABS_VOICE_ID=
ELEVENLABS_LLM=

# Where ElevenLabs reaches the API's tools and webhooks: the Render URL, https.
PUBLIC_API_URL=
# Signs the per-call token the agent's tools send back. 32+ random characters, e.g. `openssl rand -hex 32`.
CALL_TOKEN_SECRET=
# Numbers whose owners agreed to a call from an AI (E.164, comma-separated). No other number is dialled.
CALL_ALLOWLIST=

# Bearer token for POST /errands, GET /errands/:id and POST /internal/tick, until buyer sign-in exists.
LEGWORK_ADMIN_TOKEN=
# Optional: also accepted on /internal/tick (Vercel Cron sends it).
CRON_SECRET=

# Twilio (texts to shops).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Channel3 (product identification). Promo code PAYPAL-HACKATHON-2026.
CHANNEL3_API_KEY=
# Optional: a public image URL of a product, for the image-search check.
CHANNEL3_TEST_IMAGE_URL=

# Elastic Cloud serverless (Offline Index).
ELASTIC_URL=
ELASTIC_API_KEY=

# KERNEL cloud browsers (web worker).
KERNEL_API_KEY=

# Render: Postgres and Key Value connection strings (set by render.yaml in production).
# Without DATABASE_URL the API keeps errands in memory. Migrations run on start.
DATABASE_URL=
REDIS_URL=

# Optional: a Postgres server for the database tests. Each run uses a throwaway schema.
# Without it the tests use PGlite (Postgres in process).
TEST_DATABASE_URL=

PORT=3001
