{
  "name": "legwork",
  "private": true,
  "type": "module",
  "description": "An AI agent that gets real-world errands done with businesses that have no API, while PayPal holds and moves every dollar.",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "dev:api": "tsx watch apps/api/src/main.ts",
    "start:api": "tsx apps/api/src/main.ts",
    "check:day-one": "tsx scripts/day-one/index.ts",
    "voice:setup": "tsx scripts/voice/setup-agent.ts",
    "voice:call": "tsx scripts/voice/call.ts",
    "build:vercel": "node scripts/vercel/build.mjs"
  },
  "devDependencies": {
    "@channel3/sdk": "^4.6.0",
    "@electric-sql/pglite": "^0.5.15",
    "@onkernel/sdk": "^0.139.0",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
